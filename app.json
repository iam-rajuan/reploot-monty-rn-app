{
  "expo": {
    "name": "REPLOOT",
    "slug": "reloot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reloot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A11",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reloot.app"
    },
    "android": {
      "package": "com.reloot.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#070A11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KINETQX to access your camera for AI workout pose tracking and food scanning."
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "762857c7-9396-41a7-a647-a3468d7e60c7"
      }
    },
    "owner": "rajuan.edu"
  }
}
